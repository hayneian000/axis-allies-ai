{
  "name": "axis-allies-ai",
  "version": "1.0.0",
  "description": "Browser-based Axis & Allies-style strategy game with LLM AI players (BYOK). Two maps: America FFA and the 1942 world board.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/hayneian000/axis-allies-ai.git"
  },
  "homepage": "https://github.com/hayneian000/axis-allies-ai",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "simulate": "vitest run tests/simulation.test.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "probe": "node scripts/probe-branch.mjs"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
